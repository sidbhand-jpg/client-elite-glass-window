/*
  Strict-Transport-Security: max-age=15552000
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self' 'unsafe-inline' https://www.clarity.ms https://scripts.clarity.ms https://connect.facebook.net https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.facebook.com https://*.clarity.ms https://c.bing.com; connect-src 'self' https://www.clarity.ms https://*.clarity.ms https://graph.facebook.com https://challenges.cloudflare.com; frame-src https://www.google.com https://maps.google.com https://challenges.cloudflare.com; upgrade-insecure-requests

https://:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow

/404.html
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=0, must-revalidate

/public/optimized/*
  Cache-Control: public, max-age=31536000, immutable

/public/social/*
  Cache-Control: public, max-age=31536000, immutable

/public/projects/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/public/projects-optimized/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/styles.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/CONFIG.js
  Cache-Control: public, max-age=0, must-revalidate

/PROJECTS.js
  Cache-Control: public, max-age=0, must-revalidate

/components.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/generic-runtime.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
